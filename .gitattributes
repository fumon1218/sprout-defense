# Only large source/raw files use Git LFS. Game-ready assets (small WebP/GLB) are stored as normal files
# so they can be served directly (for example by GitHub Pages).
assets/source/** filter=lfs diff=lfs merge=lfs -text
raw/** filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
